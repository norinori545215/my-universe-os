rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function role() {
      return signedIn() ? request.auth.token.role : null;
    }

    function isAdmin() {
      return role() == 'ADMIN';
    }

    function isPro() {
      return role() in ['PRO', 'ADMIN', 'VIP_GUEST'];
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);

      // 本人が自分で role / isVip / vipUntil を書き換えるのを禁止。
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'isVip', 'vipUntil']);

      allow delete: if isAdmin();
    }

    match /universes/{uid} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /system/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /vip_tickets/{ticketId} {
      allow read, write: if isAdmin();
    }

    // まずはログイン必須。次の段階で participantHashes 方式へ強化する。
    match /nexus_rooms/{roomId}/messages/{messageId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    match /nexus_channels/{channelId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }
  }
}