rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function tokenRole() {
      return signedIn() ? request.auth.token.role : null;
    }

    function userDocRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function role() {
      return tokenRole() != null ? tokenRole() : userDocRole();
    }

    function isAdmin() {
      return role() == 'ADMIN';
    }

    function protectedUserFields() {
      return [
        'role',
        'isVip',
        'vipUntil',
        'vipCodeHash',
        'vipCode',
        'lastVipUnlockAt'
      ];
    }

    function safeUserCreate() {
      return signedIn()
        && (
          !request.resource.data.keys().hasAny(['role'])
          || request.resource.data.role == 'RESTRICTED'
        )
        && !request.resource.data.keys().hasAny([
          'isVip',
          'vipUntil',
          'vipCodeHash',
          'vipCode',
          'lastVipUnlockAt'
        ]);
    }

    function safeUserUpdate() {
      return signedIn()
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(protectedUserFields());
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isOwner(uid) && safeUserCreate();
      allow update: if isOwner(uid) && safeUserUpdate();

      allow create, update, delete: if isAdmin();
    }

    match /universes/{uid} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /system/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /vip_tickets/{ticketId} {
      allow read, write: if isAdmin();
    }

    match /nexus_rooms/{roomId}/messages/{messageId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    match /nexus_channels/{channelId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }
  }
}
